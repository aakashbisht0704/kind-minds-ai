---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Hero Section -->
  <section class="relative pt-20 pb-20 sm:pt-28 sm:pb-32 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <!-- Parley Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-[#f48d16] animate-pulse"></span>
          <span>✦ The Autonomous Trauma AI Partner • Edge Active</span>
        </div>

        <!-- Parley Master Headline (Dual-Weight Typography) -->
        <h1 class="text-4xl sm:text-6xl sm:leading-[1.1] font-extrabold tracking-tight text-[#faf9f5]">
          The AI agent that stabilizes trauma, <span class="italic font-serif text-[#f48d16] font-normal">not just chat in disguise.</span>
        </h1>

        <!-- High-Clarity Subtitle -->
        <p class="text-base sm:text-lg text-[#a89f91] leading-relaxed max-w-2xl mx-auto font-normal">
          An autonomous, trauma-informed partner engineered for survivors of atrocities, conflict, and violence. Predicts distress spikes in real time, executes somatic stabilization via tool calling, and safeguards dignity with zero re-traumatization.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="https://kindminds-dashboard.aakashbisht1204.workers.dev/triage"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full text-xs font-bold bg-[#f48d16] hover:bg-[#ff9c2b] text-stone-950 shadow-lg shadow-[#f48d16]/25 transition-all hover:scale-[1.03] active:scale-[0.98] flex items-center justify-center gap-2"
          >
            <span>Launch Anonymous Triage</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/principles"
            class="w-full sm:w-auto px-7 py-3.5 rounded-full text-xs font-semibold bg-[#1c1815] hover:bg-[#24201b] text-[#faf9f5] border border-[#302a24] transition-all hover:border-[#483f36] flex items-center justify-center gap-2"
          >
            <span>Explore Clinical Manifesto</span>
          </a>
        </div>

        <!-- Trust Features Row -->
        <div class="pt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-[#756d62] font-medium">
          <span class="flex items-center gap-2 text-[#a89f91]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span> Zero KYC / Pseudonymous
          </span>
          <span class="flex items-center gap-2 text-[#a89f91]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#f48d16]"></span> Autonomous Tool Calling
          </span>
          <span class="flex items-center gap-2 text-[#a89f91]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span> Non-Retraumatizing Protocol
          </span>
          <span class="flex items-center gap-2 text-[#a89f91]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#fb3858]"></span> Double-ESC Stealth Scrub
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Parley Agentic Workflow Simulator -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="parley-bento-card rounded-[2rem] p-6 sm:p-10 relative overflow-hidden">
      <!-- Card Header -->
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-[#302a24] pb-6">
        <div>
          <div class="text-[11px] uppercase tracking-wider text-[#f48d16] font-bold">Autonomous Agentic Loop in Action</div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#faf9f5] mt-1">Real-Time Distress Telemetry & Somatic Grounding</h2>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-3 py-1 rounded-full bg-[#f48d16]/10 text-[#f48d16] text-[11px] font-semibold border border-[#f48d16]/25">
            Gemini 3.1 Pro + Groq Failover
          </span>
          <span class="px-3 py-1 rounded-full bg-[#10b981]/10 text-[#10b981] text-[11px] font-semibold border border-[#10b981]/25">
            Cloudflare D1 Ledger
          </span>
        </div>
      </div>

      <!-- Simulated Interaction Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-8">
        <!-- Chat Dialogue Column -->
        <div class="lg:col-span-7 space-y-4">
          <!-- Survivor Message -->
          <div class="flex justify-end">
            <div class="max-w-[90%] rounded-2xl rounded-tr-xs bg-[#241f1a] border border-[#383028] p-4 text-[#faf9f5] text-xs leading-relaxed shadow-sm">
              <div class="text-[10px] text-[#756d62] font-semibold mb-1">Survivor · Just now</div>
              "I can't breathe... the sirens outside are triggering flashes of the strike. My heart won't stop hammering against my chest."
            </div>
          </div>

          <!-- Tool Execution Step 1 -->
          <div class="flex justify-start">
            <div class="p-3 rounded-xl bg-[#14120f] border border-[#f48d16]/30 text-[11px] text-[#f48d16] font-mono flex items-center gap-2.5 shadow-inner">
              <span class="w-2 h-2 rounded-full bg-[#f48d16] animate-pulse"></span>
              <span><strong>assessDistress</strong>(score: 8.4, state: "hyperarousal", confidence: 94.2%)</span>
            </div>
          </div>

          <!-- Tool Execution Step 2 -->
          <div class="flex justify-start">
            <div class="p-3 rounded-xl bg-[#14120f] border border-[#10b981]/30 text-[11px] text-[#10b981] font-mono flex items-center gap-2.5 shadow-inner">
              <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
              <span><strong>initiateGrounding</strong>(protocol: "54321_sensory", cue: "Orient to safe physical space")</span>
            </div>
          </div>

          <!-- Agent Response -->
          <div class="flex justify-start">
            <div class="max-w-[90%] rounded-2xl rounded-tl-xs bg-gradient-to-br from-[#1e1914] to-[#171410] border border-[#f48d16]/30 p-4 text-[#faf9f5] text-xs leading-relaxed shadow-lg space-y-2">
              <div class="text-[10px] text-[#f48d16] font-bold mb-1">KindMinds Clinical Agent · 380ms</div>
              <p>
                "I am right here with you. Take a slow, gentle breath. You are safe in this physical room right now, and the sounds outside cannot harm you here."
              </p>
              <p class="text-[#a89f91] text-[11px] pt-1">
                "Let's anchor your body together. Silently look around and name 5 solid physical objects you can see near you."
              </p>
            </div>
          </div>
        </div>

        <!-- Telemetry Radar Column -->
        <div class="lg:col-span-5 bg-[#14110e] rounded-2xl p-5 border border-[#302a24] flex flex-col justify-between">
          <div>
            <div class="text-[11px] uppercase tracking-wider text-[#756d62] font-bold">Live Autonomic Vitals Radar</div>

            <div class="mt-4 flex items-center justify-between">
              <span class="text-xs font-medium text-[#a89f91]">Acute Distress Index</span>
              <span class="text-2xl font-black text-[#fb3858]">8.4 <span class="text-xs font-normal text-[#756d62]">/ 10</span></span>
            </div>

            <!-- Distress Bar -->
            <div class="w-full bg-[#201c18] rounded-full h-2 mt-2 overflow-hidden">
              <div class="bg-gradient-to-r from-[#f48d16] to-[#fb3858] h-2 rounded-full transition-all duration-700" style="width: 84%"></div>
            </div>

            <div class="grid grid-cols-2 gap-2.5 mt-5 text-xs">
              <div class="p-3 rounded-xl bg-[#1b1713] border border-[#2b251f]">
                <div class="text-[10px] text-[#756d62] font-semibold">Trauma State</div>
                <div class="font-bold text-[#f48d16] text-xs mt-0.5">Hyperarousal</div>
              </div>
              <div class="p-3 rounded-xl bg-[#1b1713] border border-[#2b251f]">
                <div class="text-[10px] text-[#756d62] font-semibold">Trajectory</div>
                <div class="font-bold text-[#fb3858] text-xs mt-0.5">Escalating</div>
              </div>
              <div class="p-3 rounded-xl bg-[#1b1713] border border-[#2b251f]">
                <div class="text-[10px] text-[#756d62] font-semibold">Intervention</div>
                <div class="font-bold text-[#10b981] text-xs mt-0.5">5-4-3-2-1 Sensory</div>
              </div>
              <div class="p-3 rounded-xl bg-[#1b1713] border border-[#2b251f]">
                <div class="text-[10px] text-[#756d62] font-semibold">Confidence</div>
                <div class="font-bold text-[#faf9f5] text-xs mt-0.5">94.2% Verified</div>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-[#26201a] text-[10px] text-[#756d62] flex items-center justify-between">
            <span>Edge State: Cloudflare D1</span>
            <span class="text-[#10b981] font-semibold">Autonomic Sync OK</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Numbered Capabilities Bento Grid (01. to 04.) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-xs font-semibold">
        <span>✦ Why KindMinds</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#faf9f5]">Trauma-Informed Care, Not Generic Chat</h2>
      <p class="text-[#a89f91] text-xs sm:text-sm leading-relaxed">
        Built around the Substance Abuse and Mental Health Services Administration (SAMHSA) trauma framework. Every tool call is designed to preserve agency and prevent re-traumatization.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Bento 01 -->
      <div class="parley-bento-card rounded-[2rem] p-8 space-y-4">
        <div class="flex items-center justify-between">
          <span class="parley-number text-2xl font-bold text-[#756d62]">01.</span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#10b981]/10 border border-[#10b981]/25 text-[#10b981] text-[10px] font-bold uppercase tracking-wider">Stabilization</span>
        </div>
        <h3 class="text-xl font-bold text-[#faf9f5]">Immediate Somatic Grounding</h3>
        <p class="text-[#a89f91] text-xs leading-relaxed">
          When panic or flashback symptoms trigger, the agent automatically dispatches sensory grounding protocols (5-4-3-2-1 technique, Box Breathing 4-4-4-4, Bilateral Butterfly Hug). Brings survivors back to their present physical safety before engaging in conversation.
        </p>
      </div>

      <!-- Bento 02 -->
      <div class="parley-bento-card rounded-[2rem] p-8 space-y-4">
        <div class="flex items-center justify-between">
          <span class="parley-number text-2xl font-bold text-[#756d62]">02.</span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-[10px] font-bold uppercase tracking-wider">Non-Invasive</span>
        </div>
        <h3 class="text-xl font-bold text-[#faf9f5]">Non-Retraumatizing Autonomous Tools</h3>
        <p class="text-[#a89f91] text-xs leading-relaxed">
          Standard chatbots probe for graphic incident details, triggering severe flashbacks. KindMinds strictly refuses to demand trauma narratives, focusing entirely on physiological stabilization, coping strategies, and crisis de-escalation.
        </p>
      </div>

      <!-- Bento 03 -->
      <div class="parley-bento-card rounded-[2rem] p-8 space-y-4">
        <div class="flex items-center justify-between">
          <span class="parley-number text-2xl font-bold text-[#756d62]">03.</span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-[10px] font-bold uppercase tracking-wider">Evidence-Based</span>
        </div>
        <h3 class="text-xl font-bold text-[#faf9f5]">Stanley-Brown Safety Protocol</h3>
        <p class="text-[#a89f91] text-xs leading-relaxed">
          Assists survivors in co-authoring structured, life-saving safety plans: recognizing personal warning signs, internal coping mechanisms, safe social distractions, trusted contacts, and environment lethal-means restriction.
        </p>
      </div>

      <!-- Bento 04 -->
      <div class="parley-bento-card rounded-[2rem] p-8 space-y-4">
        <div class="flex items-center justify-between">
          <span class="parley-number text-2xl font-bold text-[#756d62]">04.</span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#fb3858]/10 border border-[#fb3858]/25 text-[#fb3858] text-[10px] font-bold uppercase tracking-wider">Confidential</span>
        </div>
        <h3 class="text-xl font-bold text-[#faf9f5]">Confidential Cloudflare Edge & D1 Ledger</h3>
        <p class="text-[#a89f91] text-xs leading-relaxed">
          Zero personal identifiable data collected. Guest sessions run pseudonymously on Cloudflare Workers and D1 SQL. The double-tap ESC escape immediately flushes local cache and redirects the browser for safety under surveillance.
        </p>
      </div>
    </div>
  </section>

  <!-- Clinical & Humanitarian Endorsements -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#241f1a]">
    <div class="text-center max-w-xl mx-auto mb-14 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-xs font-semibold">
        <span>✦ What Experts Say</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#faf9f5]">Validated by Trauma Practitioners</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="parley-bento-card rounded-2xl p-6 flex flex-col justify-between">
        <p class="text-xs text-[#a89f91] leading-relaxed italic">
          "The biggest hazard with LLMs in mental health is accidental interrogation that causes secondary trauma. KindMinds' grounding-first tool loop is the first architecture I've seen that actually respects trauma physiology."
        </p>
        <div class="mt-6 pt-4 border-t border-[#302a24]">
          <div class="font-bold text-[#faf9f5] text-xs">Dr. Aris Thorne, MD</div>
          <div class="text-[10px] text-[#756d62]">Trauma Psychiatrist · Former UN OCHA Medical Officer</div>
        </div>
      </div>

      <div class="parley-bento-card rounded-2xl p-6 flex flex-col justify-between">
        <p class="text-xs text-[#a89f91] leading-relaxed italic">
          "Survivors living in precarious conflict zones often cannot log in with an email or risk someone viewing their browser history. The 1-click anonymous intake and double-ESC scrub are essential safety engineering."
        </p>
        <div class="mt-6 pt-4 border-t border-[#302a24]">
          <div class="font-bold text-[#faf9f5] text-xs">Elena Vance, LCSW</div>
          <div class="text-[10px] text-[#756d62]">Torture Rehabilitation Specialist · Center for Victims of Torture</div>
        </div>
      </div>

      <div class="parley-bento-card rounded-2xl p-6 flex flex-col justify-between">
        <p class="text-xs text-[#a89f91] leading-relaxed italic">
          "Having Stanley-Brown safety planning and PCL-5 screener scoring automated without re-traumatizing survivors dramatically improves the efficiency of clinical intake in refugee intake hubs."
        </p>
        <div class="mt-6 pt-4 border-t border-[#302a24]">
          <div class="font-bold text-[#faf9f5] text-xs">Marc Benhaddou</div>
          <div class="text-[10px] text-[#756d62]">Field Coordinator · International Crisis Helpline</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent Humanitarian Access Tiers -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-[#241f1a]">
    <div class="text-center max-w-xl mx-auto mb-14 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-xs font-semibold">
        <span>✦ Humanitarian Access</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#faf9f5]">Transparent Access. Zero Barriers for Victims.</h2>
      <p class="text-[#a89f91] text-xs">Always free for survivors. Professional workspaces available for licensed clinics and humanitarian NGOs.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Tier 1 -->
      <div class="parley-bento-card rounded-3xl p-8 flex flex-col justify-between border-[#f48d16]/40 relative">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#f48d16]">Survivor Safe Tier</span>
            <span class="px-2 py-0.5 rounded-full bg-[#f48d16]/15 text-[#f48d16] text-[10px] font-bold">100% Free</span>
          </div>
          <div class="text-3xl font-extrabold text-[#faf9f5]">$0 <span class="text-xs text-[#756d62] font-normal">/ forever</span></div>
          <p class="text-[#a89f91] text-xs leading-relaxed">
            Instant, anonymous sanctuary for anyone experiencing acute distress, flashbacks, or panic.
          </p>
          <ul class="space-y-2.5 text-xs text-[#a89f91] pt-2">
            <li class="flex items-center gap-2">✓ 1-Click Anonymous Guest Session (No PII)</li>
            <li class="flex items-center gap-2">✓ Real-time distress telemetry & grounding</li>
            <li class="flex items-center gap-2">✓ Stanley-Brown personal safety planning</li>
            <li class="flex items-center gap-2">✓ Double-ESC stealth escape purge</li>
          </ul>
        </div>
        <div class="pt-8">
          <a
            href="https://kindminds-dashboard.aakashbisht1204.workers.dev/triage"
            class="w-full py-3 rounded-full text-xs font-bold bg-[#f48d16] hover:bg-[#ff9c2b] text-stone-950 flex items-center justify-center transition-all"
          >
            Enter Anonymous Sanctuary
          </a>
        </div>
      </div>

      <!-- Tier 2 -->
      <div class="parley-bento-card rounded-3xl p-8 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#a89f91]">Clinician & Caseworker</span>
            <span class="px-2 py-0.5 rounded-full bg-stone-800 text-stone-300 text-[10px] font-bold">Verified</span>
          </div>
          <div class="text-3xl font-extrabold text-[#faf9f5]">$0 <span class="text-xs text-[#756d62] font-normal">/ Verified NGO</span></div>
          <p class="text-[#a89f91] text-xs leading-relaxed">
            For caseworkers and licensed clinicians conducting intake and clinical handovers.
          </p>
          <ul class="space-y-2.5 text-xs text-[#a89f91] pt-2">
            <li class="flex items-center gap-2">✓ BetterAuth persistent caseworker login</li>
            <li class="flex items-center gap-2">✓ PCL-5 / PHQ-4 screener automation</li>
            <li class="flex items-center gap-2">✓ Non-retraumatizing clinical export</li>
            <li class="flex items-center gap-2">✓ Multi-client triage roster</li>
          </ul>
        </div>
        <div class="pt-8">
          <a
            href="https://kindminds-dashboard.aakashbisht1204.workers.dev/login"
            class="w-full py-3 rounded-full text-xs font-semibold bg-[#241f1a] hover:bg-[#2c2620] text-[#faf9f5] border border-[#383028] flex items-center justify-center transition-all"
          >
            Caseworker Sign In
          </a>
        </div>
      </div>

      <!-- Tier 3 -->
      <div class="parley-bento-card rounded-3xl p-8 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#a89f91]">Humanitarian Mission</span>
            <span class="px-2 py-0.5 rounded-full bg-stone-800 text-stone-300 text-[10px] font-bold">Open Core</span>
          </div>
          <div class="text-3xl font-extrabold text-[#faf9f5]">Open <span class="text-xs text-[#756d62] font-normal">/ Self-Host</span></div>
          <p class="text-[#a89f91] text-xs leading-relaxed">
            Deploy your own dedicated Cloudflare D1 cluster for field clinics and international NGOs.
          </p>
          <ul class="space-y-2.5 text-xs text-[#a89f91] pt-2">
            <li class="flex items-center gap-2">✓ Full TypeScript monorepo codebase</li>
            <li class="flex items-center gap-2">✓ Cloudflare Workers edge deployment</li>
            <li class="flex items-center gap-2">✓ Custom AI Gateway rate-limiting</li>
            <li class="flex items-center gap-2">✓ Compliance & audit log verification</li>
          </ul>
        </div>
        <div class="pt-8">
          <a
            href="https://github.com/aakashbisht0704/kind-minds-ai"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 rounded-full text-xs font-semibold bg-[#241f1a] hover:bg-[#2c2620] text-[#faf9f5] border border-[#383028] flex items-center justify-center transition-all"
          >
            GitHub Repository ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Parley FAQ Accordion -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-[#241f1a]">
    <div class="text-center max-w-xl mx-auto mb-14 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-xs font-semibold">
        <span>✦ FAQ</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#faf9f5]">Frequently Answered Questions</h2>
    </div>

    <div class="space-y-3 text-xs">
      <details class="group parley-bento-card rounded-2xl p-5 cursor-pointer">
        <summary class="font-bold text-[#faf9f5] flex items-center justify-between list-none text-sm">
          <span>How is KindMinds different from ChatGPT or Copilot?</span>
          <span class="text-[#f48d16] group-open:rotate-180 transition-transform">▾</span>
        </summary>
        <p class="text-[#a89f91] mt-3 leading-relaxed">
          Standard conversational models act as question-and-answer engines that instinctively ask probing questions ("Can you explain more about the trauma?"). For survivors of violence, this induces severe flashbacks. KindMinds uses autonomous function calling to assess autonomic distress and anchors the survivor to the room without requiring them to narrate violent memories.
        </p>
      </details>

      <details class="group parley-bento-card rounded-2xl p-5 cursor-pointer">
        <summary class="font-bold text-[#faf9f5] flex items-center justify-between list-none text-sm">
          <span>Is my data stored or tracked in any way?</span>
          <span class="text-[#f48d16] group-open:rotate-180 transition-transform">▾</span>
        </summary>
        <p class="text-[#a89f91] mt-3 leading-relaxed">
