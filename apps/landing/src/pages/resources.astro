---
import Layout from "../layouts/Layout.astro";
import { DEFAULT_VERIFIED_RESOURCES } from "@kindminds/db";
---

<Layout title="Global Verified Resources — KindMinds Trauma System">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="space-y-3 text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-xs font-semibold">
        <span>✦ Global Support Network</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#faf9f5] tracking-tight">Verified Crisis & Torture Rehabilitation Directory</h1>
      <p class="text-[#a89f91] text-xs sm:text-sm leading-relaxed">
        Trusted, confidential humanitarian organizations providing direct psychosocial, medical, and legal assistance to survivors of armed conflict, state violence, and torture.
      </p>
    </div>

    <!-- Urgent Crisis Banner -->
    <div class="p-6 rounded-3xl bg-[#160f10] border border-[#fb3858]/30 text-[#fb3858] mb-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xl">
      <div>
        <div class="font-bold text-sm text-[#faf9f5] flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#fb3858] animate-ping"></span>
          Immediate 24/7 Crisis Support
        </div>
        <div class="text-xs text-[#a89f91] mt-1 max-w-xl">
          If you or someone near you is in acute emotional crisis, self-harm risk, or danger, free professional lifelines are available right now.
        </div>
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        <a
          href="tel:988"
          class="px-5 py-2.5 bg-[#fb3858] hover:bg-[#ff4d6a] text-white font-bold rounded-full text-xs shadow-md transition-colors"
        >
          Call/Text 988 (USA/Canada)
        </a>
        <a
          href="https://findahelpline.com"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 bg-[#241f1a] hover:bg-[#2c2620] text-[#faf9f5] font-medium rounded-full text-xs border border-[#383028] transition-colors"
        >
          Find Local Line Worldwide ↗
        </a>
      </div>
    </div>

    <!-- Resources Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {DEFAULT_VERIFIED_RESOURCES.map((res) => (
        <div class="parley-bento-card rounded-3xl p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full bg-[#f48d16]/10 border border-[#f48d16]/25 text-[#f48d16] text-[10px] font-bold uppercase tracking-wider">
                {res.specialty.replace(/_/g, " ")}
              </span>
              <span class="text-xs text-[#756d62] font-semibold">{res.countryCode}</span>
            </div>
            <h3 class="text-base font-bold text-[#faf9f5] leading-snug">{res.name}</h3>
            <p class="text-[#a89f91] text-xs leading-relaxed mt-2.5">{res.description}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#302a24] space-y-2 text-xs">
            {res.hotline && (
              <div class="flex items-center justify-between text-[#a89f91]">
                <span class="text-[#756d62]">Phone:</span>
                <a href={`tel:${res.hotline}`} class="font-mono text-[#f48d16] hover:underline font-semibold">{res.hotline}</a>
              </div>
            )}
            <div class="flex items-center justify-between text-[#a89f91]">
              <span class="text-[#756d62]">Languages:</span>
              <span class="text-[#a89f91] truncate max-w-[160px]">{res.languages.join(", ")}</span>
            </div>
            <div class="pt-3">
              <a
                href={res.website}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-full bg-[#241f1a] hover:bg-[#2e2721] text-[#faf9f5] text-xs font-semibold border border-[#383028] transition-colors"
              >
                <span>Visit Official Site</span>
                <svg class="w-3 h-3 text-[#f48d16]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
