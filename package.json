{
  "name": "kindminds-trauma-support-system",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Based Real-Time Mental Health, Stress and Trauma Assessment & Distress Prediction System for Victims of Atrocities",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "bun --filter @kindminds/landing dev",
    "dev:dashboard": "bun --filter @kindminds/dashboard dev",
    "build:landing": "bun --filter @kindminds/landing build",
    "build:dashboard": "bun --filter @kindminds/dashboard build",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@tanstack/router-generator": "1.120.20",
    "typescript": "^5.7.3"
  }
}
